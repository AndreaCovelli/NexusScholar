# .env.example
# Copy this file to .env and fill in the actual values.
# DO NOT COMMIT .env TO THE REPOSITORY.

# --- Application Configuration ---
APP_PORT=8080

# --- MongoDB Configuration ---
# Use the connection string for the replica set.
# Example for local Docker Compose development:
MONGO_URI=mongodb://admin:secretpassword@mongo1:27017,mongo2:27018,mongo3:27019/nexusscholar?replicaSet=rs0&authSource=admin
MONGO_USER=admin
MONGO_PASSWORD=secretpassword
MONGO_DB_NAME=dbname

# --- Neo4j Configuration ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secretpassword