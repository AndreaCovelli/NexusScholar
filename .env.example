# .env
# KEEP THIS FILE SECURE. DO NOT COMMIT TO GIT.

# --- Application Configuration ---
APP_PORT=8080

# --- MongoDB Configuration ---
# User and Password used by the Docker container to initialize the DB
MONGO_USER=admin
MONGO_PASSWORD=secretpassword
MONGO_DB_NAME=nexusscholar

# (Optional) Full URI for local testing tools (e.g., Compass)
MONGO_URI=mongodb://admin:secretpassword@localhost:27017/nexusscholar?authSource=admin

# --- Neo4j Configuration ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secretpassword

# --- JWT Configuration ---
# I generated a strong random key for you.
JWT_SECRET_KEY=7d8f3b2a1e9c4d5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9
# Token validity in milliseconds (3600000 ms = 1 hour)
JWT_VALIDITY_IN_MILLISECONDS=3600000